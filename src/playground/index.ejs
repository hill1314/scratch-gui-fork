<!DOCTYPE html>
<html>
  <head>
    <% if (htmlWebpackPlugin.options.gtm_id) { %>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl+'<%= htmlWebpackPlugin.options.gtm_env_auth %>';
        f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','<%- htmlWebpackPlugin.options.gtm_id %>');
    </script>
    <!-- End Google Tag Manager -->
    <% } %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="google" value="notranslate">
    <link rel="shortcut icon" href="static/favicon.ico">
    <title><%= htmlWebpackPlugin.options.title %></title>
    <style>
      /* JARVIS 集成（二次开发）：返回家庭中枢的悬浮按钮。
       * 注意必须写在这里（而不是 index.css）：index.css 走 CSS Modules，
       * 类名会被哈希成 index_jarvis-back_xxxx，而 index.ejs 里是裸类名，对不上。
       * 放在 body 直接子级、不塞进 React 树：不干扰 Scratch 的 flex 布局，升级冲突面也小。 */
      .jarvis-back {
        /* 位置演进：
         * 1) 最初在左上角(top:8;left:8) → 压住 Scratch 自己的 Logo，两个按钮叠在一起。
         * 2) 改浮到「舞台画布右上角」(top:96) → 不挡 Logo/账号区/舞台控制条，但悬在画布上，
         *    视觉上像块补丁，也遮舞台内容。
         * 3) 现在移到「顶栏内右侧」：顶栏高 48px（$menu-bar-height: 3rem），按钮高 25px，
         *    垂直居中 → top 取 11px。右侧账号区(account-info-group)只占最右 32px，
         *    right 留 48px 正好让开它，不与任何顶栏元素重叠。
         *    顶栏是 position:relative + z-index:491，按钮 fixed + z-index:1000 可覆盖在上层。 */
        position: fixed; top: 11px; right: 48px; z-index: 1000;
        display: inline-flex; align-items: center; gap: 6px;
        /* 落在紫色顶栏上，用半透明白底 + 深色字，比原来的深色块更协调，也不抢焦点 */
        padding: 5px 11px 5px 9px; border-radius: 999px;
        background: rgba(255, 255, 255, .18); color: #fff;
        border: 1px solid rgba(255, 255, 255, .34);
        font: 700 13px/1 -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
        text-decoration: none;
        opacity: .82; transition: opacity .15s, background .15s, transform .15s;
      }
      .jarvis-back:hover { opacity: 1; background: rgba(255, 255, 255, .3); transform: translateY(-1px); }
      .jarvis-back:active { transform: scale(.97); }
      @media (max-width: 1200px) {
        /* 窄屏时顶栏文字更挤，按钮收紧并再让开一点 */
        .jarvis-back { top: 12px; right: 40px; padding: 4px 9px 4px 7px; font-size: 12px; }
      }

      /* ===== JARVIS 集成（二次开发）：平板/窄屏自适应 =====
       *
       * 为什么需要单独一段：Scratch 官方 GUI 是桌面双栏布局，源码里写死了
       *   .editor-wrapper { flex-basis: calc(1024px - 408px - ...); flex-shrink: 0; }
       * 注释里也明说「GUI 最小显示宽度 1024px」。平板横屏（1024~1280 逻辑宽）
       * 刚好卡在临界点，舞台被压得很小；更窄时因为 flex-shrink:0 不肯收缩，
       * 舞台直接被挤出可视区、整页出现横向滚动。
       *
       * 这里用 CSS Modules 的**属性选择器**（[class*="editor-wrapper"]）来打补丁：
       * 类名被哈希成 editor-wrapper_xxxx 之类，用半匹配才能稳定命中，
       * 且不必改 React 组件、升级冲突面最小。
       *
       * 策略（横屏为主）：
       *   1) 允许积木列收缩（flex-shrink:1）+ 去掉 1024 的硬下限；
       *   2) 窄屏把工具箱/标签页宽度 250px → 180px，把横向空间让给舞台；
       *   3) 顶栏精简：隐藏文件/编辑等文字标签，只留图标（官方已有同名规则，
       *      但断点只在 1024，这里补齐到 1200 并加上 Logo 收紧）；
       *   4) 彻底禁掉整页横向滚动（Scratch 内部各 Scroll 容器自己处理）。
       */
      @media (max-width: 1280px) {
        /* 1) 让左侧积木列可以收缩，舞台列不再被顶出去 */
        [class*="editor-wrapper"] {
          flex-basis: 0 !important;
          flex-grow: 1 !important;
          flex-shrink: 1 !important;
          min-width: 0 !important;
        }
        [class*="flex-wrapper"] { overflow-x: hidden !important; }
        html, body { overflow-x: hidden !important; }

        /* 2) 工具箱/标签页收窄，给舞台腾地方 */
        [class*="tab-list"] { width: 180px !important; }

        /* 3) 顶栏精简：窄屏只留图标不显示文字标签 */
        [class*="collapsible-label"],
        [class*="tutorials-label"],
        [class*="debug-label"] { display: none !important; }

        /* 顶栏各项更紧凑，避免挤成两行 */
        [class*="menu-bar-item"] { padding: 0 0.15rem !important; }
        [class*="scratch-logo"] { height: 1.25rem !important; }
      }

      /* 更窄（竖屏平板 / 小尺寸横屏）：进一步压缩侧栏与舞台内边距 */
      @media (max-width: 1024px) {
        [class*="tab-list"] { width: 150px !important; }
        [class*="stage-and-target-wrapper"] {
          padding-left: 0.25rem !important;
          padding-right: 0.25rem !important;
        }
        [class*="sprite-selector"] { min-width: 0 !important; }
      }

      /* 触屏：放大可点区域，避免手指误触（鼠标端不受影响） */
      @media (pointer: coarse) {
        [class*="menu-bar-item"] { min-height: 2.25rem; }
        .jarvis-back { padding: 7px 13px 7px 11px; font-size: 14px; }
      }
    </style>

  </head>
  <body>
    <!-- JARVIS 集成（二次开发）：返回家庭中枢的悬浮入口。
         只有加了 ?jarvis=1 才显示，这样直接打开 Scratch（纯开发调试）时不碍事。 -->
    <a class="jarvis-back" id="jarvisBack" href="/" title="返回 JARVIS 家庭中枢" style="display:none">
      <span aria-hidden="true">←</span><span>JARVIS</span>
    </a>
    <script>
      (function () {
        var q = new URLSearchParams(location.search);
        if (q.get('jarvis') === '1') {
          var el = document.getElementById('jarvisBack');
          if (el) el.style.display = '';
        }
        /* 素材服务器改走同源代理。
         *
         * 官方的角色库/造型/声音都在 assets.scratch.mit.edu 上，国内直连会 timeout，
         * 表现就是「角色库一片破图、造型加载不出来」。经 JARVIS 网关（8765）打开时，
         * 由网关的 /scratch-assets/ 代为取回。这里必须在 React 应用挂载**之前**设好：
         * project-fetcher-hoc.jsx 在构造 storage 时会读这个值决定默认 assetHost。
         *
         * 判断方式：URL 里带 jarvis=1，或者页面本身就不是 8601 直连（说明是反代进来的）。
         * 单独 npm start 调试（localhost:8601）时仍用官方地址，行为与上游一致。 */
        var viaJarvis = q.get('jarvis') === '1' || location.port !== '8601';
        if (viaJarvis) window.__SCRATCH_ASSET_HOST__ = location.origin + '/scratch-assets';
      })();
    </script>
    <% if (htmlWebpackPlugin.options.gtm_id) { %>
      <!-- Google Tag Manager (noscript) -->
      <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=<%- htmlWebpackPlugin.options.gtm_id %><%= htmlWebpackPlugin.options.gtm_env_auth %>" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
      <!-- End Google Tag Manager (noscript) -->
    <% } %>
  </body>
</html>
